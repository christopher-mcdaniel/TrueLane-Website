    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.truelanedesk.com" }], "destination": "https://usetruelane.com/build.html", "permanent": true },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.usetruelane.com" }], "destination": "https://usetruelane.com/$1", "permanent": true }
  ]
